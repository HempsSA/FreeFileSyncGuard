<Application x:Class="SyncGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SyncGuard.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
      <conv:LevelToBrushConverter x:Key="LevelToBrush"/>
      <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
