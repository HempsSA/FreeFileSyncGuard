<Window x:Class="SyncGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SyncGuard.ViewModels"
        Title="SyncGuard — FreeFileSync Job Manager" Height="820" Width="1240"
        WindowState="Maximized" Icon="/Assets/app.png"
        Background="{StaticResource BgBrush}">
  <Grid Background="{StaticResource BgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="200"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <DockPanel Grid.Row="0" Margin="12,10,12,4" Background="{StaticResource BgBrush}">
      <TextBlock Text="🛡 SyncGuard" FontSize="20" FontWeight="Bold"
                 Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="+ New Job" Command="{Binding NewJobCommand}"/>
        <Button Content="Duplicate" Command="{Binding DuplicateJobCommand}"/>
        <Button Content="Remove" Command="{Binding RemoveJobCommand}"/>
        <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveJobCommand}"/>
        <Button Content="▶ Run Now" Style="{StaticResource BlueButton}" Command="{Binding RunJobCommand}"/>
        <Button Content="▶▶ Run All" Command="{Binding RunAllJobsCommand}"/>
      </StackPanel>
    </DockPanel>

    <!-- Main area -->
    <Grid Grid.Row="1" Margin="12,4" Background="{StaticResource BgBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Job list -->
      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Jobs" Foreground="{StaticResource MutedBrush}">
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2">
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                           Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Status}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="⬇ Export" Command="{Binding ExportSettingsCommand}"/>
          <Button Content="⬆ Import" Command="{Binding ImportSettingsCommand}"/>
        </StackPanel>
      </Grid>

      <!-- Detail tabs -->
      <TabControl Grid.Column="1" Background="{StaticResource SurfaceBrush}">

        <!-- Config -->
        <TabItem Header="Config">
          <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Label Content="Job Name"/>
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
              <Label Content="Source Path"/>
              <DockPanel>
                <Button Content="…" Width="36" DockPanel.Dock="Right" Command="{Binding BrowseSourceCommand}"/>
                <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <Label Content="FreeFileSync Exe"/>
              <DockPanel>
                <Button Content="…" Width="36" DockPanel.Dock="Right" Command="{Binding BrowseFfsCommand}"/>
                <TextBox Text="{Binding FfsExe, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <Label Content="Batch File (.ffs_batch)"/>
              <DockPanel>
                <Button Content="…" Width="36" DockPanel.Dock="Right" Command="{Binding BrowseBatchCommand}"/>
                <TextBox Text="{Binding BatchFile, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <Label Content="Log File"/>
              <DockPanel>
                <Button Content="…" Width="36" DockPanel.Dock="Right" Command="{Binding BrowseLogFileCommand}"/>
                <TextBox Text="{Binding LogFile, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <TextBlock Text="{Binding PathStatus}" Foreground="{StaticResource MutedBrush}" Margin="3,2"/>
              <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="Change threshold"/>
                <Slider Grid.Column="1" Minimum="1" Maximum="99" Value="{Binding Threshold}"/>
                <TextBlock Grid.Column="2" Text="{Binding Threshold, StringFormat={}{0}%}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                <Label Grid.Row="1" Content="Hours back"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="168" Value="{Binding HoursBack}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HoursBack, StringFormat={}{0}h}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                <Label Grid.Row="2" Content="Workers (0=auto)"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="64" Value="{Binding NumWorkers}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding NumWorkers}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
              </Grid>
              <DockPanel>
                <Button Content="Windows defaults" DockPanel.Dock="Right" Padding="8,2"
                        Command="{Binding LoadWindowsDefaultsCommand}"
                        ToolTip="Merge the common Windows exclude patterns (*.tmp, Recycle Bin, logs, …)"/>
                <Label Content="Exclude Patterns (*.tmp, ~$*, .git — one per line)"/>
              </DockPanel>
              <TextBox Text="{Binding ExcludeText}" AcceptsReturn="True" Height="70"
                       FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
              <CheckBox Content="Job enabled" IsChecked="{Binding Enabled}" Margin="3,8"/>
              <DockPanel Margin="0,6">
                <Button Content="Clear Cache" DockPanel.Dock="Right" Command="{Binding ClearCacheCommand}"/>
                <TextBlock Text="{Binding CacheInfo}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              </DockPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Schedule -->
        <TabItem Header="Schedule">
          <StackPanel Margin="14">
            <TextBlock Text="Scheduled Run Times" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Runs every day at these times (24h format)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding ScheduleTimes}" Height="180" FontFamily="Consolas" FontSize="14">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Button Content="✕" DockPanel.Dock="Right" Padding="8,1"
                            Command="{Binding DataContext.RemoveScheduleTimeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8">
              <TextBox Text="{Binding NewTimeText, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
              <Button Content="+ Add" Style="{StaticResource AccentButton}" Command="{Binding AddScheduleTimeCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding NextRunText}" Foreground="{StaticResource MutedBrush}" Margin="3"/>
            <TextBlock Text="{Binding CountdownText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="3"/>
          </StackPanel>
        </TabItem>

        <!-- History -->
        <TabItem Header="History">
          <DockPanel Margin="14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="Export CSV" Command="{Binding ExportHistoryCsvCommand}"/>
              <Button Content="Clear History" Command="{Binding ClearHistoryCommand}"/>
              <TextBlock Text="{Binding HistoryStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,0"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding HistoryRecords}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N0}" Width="80"/>
                <DataGridTextColumn Header="Changed" Binding="{Binding Changed, StringFormat=N0}" Width="80"/>
                <DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="60"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationSeconds, StringFormat={}{0:F0}s}" Width="80"/>
                <DataGridTextColumn Header="Trigger" Binding="{Binding TriggeredBy}" Width="90"/>
                <DataGridTextColumn Header="Score" Binding="{Binding AnomalyScore}" Width="60"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- Guardian -->
        <TabItem Header="Guardian">
          <StackPanel Margin="14">
            <TextBlock Text="Folder Guardian" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Renames are blocked and reverted in real time; deletions are logged. The lockfile is auto-restored."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Label Content="Folder to protect"/>
            <DockPanel>
              <Button Content="…" Width="36" DockPanel.Dock="Right" Command="{Binding BrowseGuardianCommand}"/>
              <TextBox Text="{Binding GuardianFolder, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <CheckBox Content="Auto-pause while FreeFileSync is running" IsChecked="{Binding GuardianAutoPause}" Margin="3,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
              <Button Content="Start Guardian" Style="{StaticResource AccentButton}"
                      Command="{Binding GuardianStartCommand}"
                      IsEnabled="{Binding GuardianRunning, Converter={StaticResource InverseBoolean}}"/>
              <Button Content="{Binding GuardianPauseText}" Command="{Binding GuardianPauseResumeCommand}"
                      IsEnabled="{Binding GuardianRunning}"/>
              <Button Content="Stop" Command="{Binding GuardianStopCommand}" IsEnabled="{Binding GuardianRunning}"/>
            </StackPanel>
            <TextBlock Text="{Binding GuardianStatus}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="3,8"/>
          </StackPanel>
        </TabItem>

        <!-- Ransomware -->
        <TabItem Header="Ransomware">
          <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Ransomware Protection" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
              <CheckBox Content="Enable entropy + extension + anomaly checks" IsChecked="{Binding RansomwareProtection}" Margin="3,8"/>
              <Label Content="Destination Path (snapshot + post-sync validation)"/>
              <DockPanel>
                <Button Content="…" Width="36" DockPanel.Dock="Right" Command="{Binding BrowseDestinationCommand}"/>
                <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <CheckBox Content="Capture destination snapshot before sync" IsChecked="{Binding SnapshotBeforeSync}" Margin="3,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="Entropy threshold"/>
                <Slider Grid.Column="1" Minimum="5" Maximum="8" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding EntropyThreshold}"/>
                <TextBlock Grid.Column="2" Text="{Binding EntropyThreshold, StringFormat={}{0:F1}}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                <Label Grid.Row="1" Content="Block score"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AnomalyBlockScore}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AnomalyBlockScore, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
              </Grid>
              <Label Content="Max snapshots kept"/>
              <TextBox Text="{Binding MaxSnapshots, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
              <Label Content="Extra suspicious extensions (one per line, without dot)"/>
              <TextBox Text="{Binding CustomExtensionsText}" AcceptsReturn="True" Height="80"
                       FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
              <TextBlock Margin="3,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Text="Score weights — change rate 40%, high entropy 25, suspicious extensions 20, mass deletions 15, mass renames 10. Sync is blocked when the score exceeds the block score."/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Notifications -->
        <TabItem Header="Notifications">
          <StackPanel Margin="14">
            <TextBlock Text="Push Notifications (ntfy)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <CheckBox Content="Enable notifications" IsChecked="{Binding NtfyEnabled}" Margin="3,8"/>
            <Label Content="Server"/>
            <TextBox Text="{Binding NtfyServer, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Topic"/>
            <TextBox Text="{Binding NtfyTopic, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Access token (optional)"/>
            <TextBox Text="{Binding NtfyToken, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8">
              <CheckBox Content="Notify on OK" IsChecked="{Binding NtfyOk}"/>
              <CheckBox Content="Notify on WARN" IsChecked="{Binding NtfyWarn}"/>
              <CheckBox Content="Notify on ERROR" IsChecked="{Binding NtfyError}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveNotificationsCommand}"/>
              <Button Content="Send Test" Command="{Binding TestNotificationCommand}"/>
              <TextBlock Text="{Binding NtfyStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,0"/>
            </StackPanel>
          </StackPanel>
        </TabItem>

        <!-- FFS Excludes -->
        <TabItem Header="FFS Excludes">
          <Grid Margin="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="110"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button Content="Browse Files…" Command="{Binding FfsBrowseFilesCommand}"/>
              <Button Content="Scan Folder…" Command="{Binding FfsScanFolderCommand}"/>
              <Button Content="Clear" Command="{Binding FfsClearCommand}"/>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding FfsFiles}" SelectedItem="{Binding SelectedFfsFile}" Margin="0,6" FontFamily="Consolas" FontSize="11"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <TextBlock Text="Exclude Filters" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
              <Button Content="Reset to Defaults" Command="{Binding FfsResetFiltersCommand}"/>
            </StackPanel>
            <TextBox Grid.Row="3" Text="{Binding FfsFilterText}" AcceptsReturn="True"
                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6">
              <Button Content="Preview (Dry Run)" Style="{StaticResource BlueButton}" Command="{Binding FfsPreviewCommand}"/>
              <Button Content="Apply Filters" Style="{StaticResource AccentButton}" Command="{Binding FfsApplyCommand}"/>
            </StackPanel>
            <TextBox Grid.Row="5" Text="{Binding FfsOutput}" IsReadOnly="True"
                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                     Foreground="{StaticResource MutedBrush}"/>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Progress -->
    <DockPanel Grid.Row="2" Margin="12,4" Background="{StaticResource BgBrush}">
      <Button Content="Clear" DockPanel.Dock="Right" Command="{Binding ClearLogCommand}" Padding="8,2"/>
      <Button Content="Abort" DockPanel.Dock="Right" Command="{Binding AbortScanCommand}"
              IsEnabled="{Binding IsRunning}" Padding="8,2"/>
      <Button Content="{Binding ScanPauseText}" DockPanel.Dock="Right" Command="{Binding PauseResumeScanCommand}"
              IsEnabled="{Binding IsRunning}" Padding="8,2"/>
      <ProgressBar Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}"
                   Width="220" Margin="0,0,10,0"/>
      <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>

    <!-- Activity log -->
    <ListBox Grid.Row="3" Margin="12,0,12,10" ItemsSource="{Binding LogLines}"
             FontFamily="Consolas" FontSize="11" x:Name="LogBox">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Message}" ToolTip="{Binding Time}"
                     Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
