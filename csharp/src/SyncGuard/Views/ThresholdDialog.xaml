<Window x:Class="SyncGuard.Views.ThresholdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Threshold Exceeded" Height="240" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="⚠ Change threshold exceeded" FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource WarnBrush}"/>
    <TextBlock x:Name="DetailText" Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,0"
               Foreground="{StaticResource TextBrush}"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Abort Sync" Width="110" Click="Abort_Click"/>
      <Button Content="Override &amp; Run" Width="130" Style="{StaticResource WarnButtonStyle}" Click="Override_Click"/>
    </StackPanel>
  </Grid>
</Window>
